# --- Aplicação ---
# APP_ENV=development
# DEBUG=True
# PORT=8000

# --- Banco de dados ---
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_do_banco

# --- Segurança ---
# SECRET_KEY=troque-por-uma-chave-secreta-gerada-localmente

# JWT_SECRET=
# CORS_ORIGINS=http://localhost:5173

# --- Pipeline RAG ---
# Valores padrão do docker-compose.yml e do Ollama local
# DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# OLLAMA_URL=http://localhost:11434


# --- Banco de dados pessoais/login (app "credenciais") ---
# Valores padrão já batem com o serviço "credenciais-postgres" do docker-compose.yml
# CONTAS_DB_NAME=credenciais
# CONTAS_DB_USER=credenciais
# CONTAS_DB_PASSWORD=credenciais
# CONTAS_DB_HOST=localhost
# CONTAS_DB_PORT=5433

# --- Banco de negócio (app "core_api") ---
# Sem essas variáveis, usa SQLite local (db.sqlite3) — atalho de dev
# enquanto o Postgres oficial do time não está pronto. Ao migrar,
# preenche as quatro variáveis abaixo e roda `manage.py migrate` de novo.
# DEFAULT_DB_ENGINE=django.db.backends.postgresql
# DEFAULT_DB_NAME=akaer_negocio
# DEFAULT_DB_USER=
# DEFAULT_DB_PASSWORD=
# DEFAULT_DB_HOST=localhost
# DEFAULT_DB_PORT=5432
