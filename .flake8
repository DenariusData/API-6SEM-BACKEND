[flake8]
max-line-length = 88

exclude =
    .git,
    __pycache__,
    venv,
    env,
    migrations,
    node_modules,
    */seeds/*

ignore =
    W503,
    E203

per-file-ignores =
    core_api/models/__init__.py:F401
    core_api/admin.py:F401
    core_api/management/commands/*.py:E501
    core_api/services/rag/*.py:E501
